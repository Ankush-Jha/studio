{
  "id": "heloc-paul",
  "title": "Interest-only HELOC: the payment moves, the balance doesn't",
  "ideaTitle": "Paul's HELOC: $7,800 paid, still owes $150,000",
  "asOf": "2026-11-16",
  "group": 2,
  "series": "HELOC",
  "tag": "Illustrative story",
  "sources": [
    {
      "fact": "Big-bank prime went from 4.45% to 4.70% on Oct 29, 2026, after the Bank of Canada raised its rate to 2.50% on Oct 28",
      "url": "https://www.bankofcanada.ca/2026/10/fad-press-release-2026-10-28/"
    },
    {
      "fact": "On an interest-only HELOC each 0.25% adds about $21 a month per $100K ($100,000 x 0.25% / 12)",
      "url": "calc: lib/calc.mjs heloc-interest-only"
    }
  ],
  "calc": {
    "kind": "heloc-interest-only",
    "inputs": {
      "principal": 150000,
      "primeNow": 4.7,
      "primeBefore": 4.45,
      "spread": 0.5,
      "nextChange": 0.25,
      "customPayment": 850,
      "months": 12
    }
  },
  "expect": [
    {
      "key": "paymentBefore",
      "shown": 619,
      "claim": "About $619 a month before Oct 29 ($618.75)"
    },
    {
      "key": "paymentNow",
      "shown": 650,
      "claim": "$650 a month now"
    },
    {
      "key": "deltaBefore",
      "shown": 31,
      "claim": "+$31 after the Oct 29 prime change"
    },
    {
      "key": "paidIO",
      "shown": 7800,
      "claim": "12 payments: $7,800"
    },
    {
      "key": "balanceIO",
      "shown": 150000,
      "claim": "Balance unchanged at $150,000"
    },
    {
      "key": "paymentNext",
      "shown": 681,
      "claim": "About $681 if Dec 9 brings another 0.25%"
    },
    {
      "key": "principalCustom",
      "shown": 2458,
      "claim": "Paying $850 takes about $2,450 off in year one ($2,458.03)"
    },
    {
      "key": "balanceCustom",
      "shown": 147542,
      "claim": "Balance about $147,542 after a year at $850"
    }
  ],
  "assumptions": "Illustrative composite, not a real client. HELOC at prime + {spread} = {rateNow}, variable, no fixed term, interest-only minimum, {apr}. Big-bank prime {primeNow} since Oct 29, 2026. Rates as of Nov 16, 2026.",
  "apr": null,
  "kinetic": {
    "cards": [
      {
        "text": "$7,800 paid.|Still owes ==$150,000==."
      },
      {
        "kind": "number",
        "label": "Interest only",
        "from": "@paymentBefore",
        "to": "@paymentNow",
        "strike": true,
        "caption": "a month"
      },
      {
        "text": "Pay ==$850==:|{principalCustom} off in a year."
      }
    ]
  },
  "byClient": {
    "northline-mortgages": {
      "series": "HELOC · Toronto",
