# Studio keys. Paste the values after the = sign, save, then tell Claude "keys added".
# Never share this file. Studio only reads it; it never prints the values.

# YouTube Data API v3 key (Google Cloud > APIs & Services > Credentials > Create credentials > API key)
YOUTUBE_API_KEY=

# Instagram Business Discovery (Meta Graph API Explorer > your app > token with instagram_basic, pages_show_list, business_management)
META_ACCESS_TOKEN=
# Your agency's Instagram Business account id (Graph API Explorer: GET me/accounts?fields=instagram_business_account)
META_IG_USER_ID=
